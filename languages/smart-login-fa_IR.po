#: admin/class-sml-admin-page.php:1004
msgid "Name, email, address, phone…"
msgstr "نام، ایمیل، نشانی، تلفن…"

#: admin/class-sml-admin-page.php:1006
msgid "All statuses"
msgstr "همهٔ وضعیت‌ها"

#: admin/class-sml-admin-page.php:1013
msgid "All customers"
msgstr "همهٔ مشتریان"

#: admin/class-sml-admin-page.php:1014
msgid "Has orders"
msgstr "دارای سفارش"

#: admin/class-sml-admin-page.php:1015
msgid "No orders"
msgstr "بدون سفارش"

#: admin/class-sml-admin-page.php:1019
msgid "Registered: any time"
msgstr "ثبت‌نام: هر زمان"

#: admin/class-sml-admin-page.php:1020
msgid "Registered: last 24h"
msgstr "ثبت‌نام: ۲۴ ساعت گذشته"

#: admin/class-sml-admin-page.php:1021
msgid "Registered: last 7 days"
msgstr "ثبت‌نام: ۷ روز گذشته"

#: admin/class-sml-admin-page.php:1022
msgid "Registered: last 30 days"
msgstr "ثبت‌نام: ۳۰ روز گذشته"

#: admin/class-sml-admin-page.php:1023
msgid "Registered: last 12 months"
msgstr "ثبت‌نام: ۱۲ ماه گذشته"

#: admin/class-sml-admin-page.php:1036
msgid "Address"
msgstr "نشانی"

#: admin/class-sml-admin-page.php:1042
msgid "Resets"
msgstr "بازیابی‌ها"

#: admin/class-sml-admin-page.php:1045
msgid "Orders"
msgstr "سفارش‌ها"

#: admin/class-sml-admin-page.php:1046
msgid "Spent"
msgstr "مجموع خرید"

#: admin/class-sml-admin-page.php:1048
msgid "Last order"
msgstr "آخرین سفارش"

#: admin/class-sml-admin-page.php:110
msgid "Sign-ups, verification, and recent activity at a glance."
msgstr "ثبت‌نام‌ها، تأیید ایمیل و فعالیت‌های اخیر، یک‌جا و در یک نگاه."

#. translators: %s: number of users
#: admin/class-sml-admin-page.php:1192
#, php-format
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s کاربر"
msgstr[1] "%s کاربر"

#: admin/class-sml-admin-page.php:1319
msgid "No matching users."
msgstr "کاربری با این مشخصات پیدا نشد."

#: admin/class-sml-admin-page.php:135
msgid "Core behaviour of the login and registration form."
msgstr "رفتار اصلی فرم ورود و ثبت‌نام."

#: admin/class-sml-admin-page.php:138
msgid "Behaviour"
msgstr "رفتار"

#: admin/class-sml-admin-page.php:1390
msgid "Prev"
msgstr "قبلی"

#: admin/class-sml-admin-page.php:1410
msgid "Next"
msgstr "بعدی"

#: admin/class-sml-admin-page.php:143
msgid "Enable registration"
msgstr "فعال‌سازی ثبت‌نام"

#: admin/class-sml-admin-page.php:144
msgid "When off, the shortcode renders a login-only form and hides the Register tab."
msgstr "در صورت غیرفعال بودن، شورت‌کد فقط فرم ورود را نمایش می‌دهد و زبانهٔ ثبت‌نام پنهان می‌شود."

#: admin/class-sml-admin-page.php:149
msgid "Enable custom login form"
msgstr "فعال‌سازی فرم ورود سفارشی"

#: admin/class-sml-admin-page.php:150
msgid "Lets an admin disable the entire front-end form (shortcode renders nothing) without deactivating the plugin."
msgstr "به مدیر امکان می‌دهد کل فرم سایت را (شورت‌کد چیزی نمایش نمی‌دهد) بدون غیرفعال کردن افزونه خاموش کند."

#: admin/class-sml-admin-page.php:155
msgid "Default role for new users"
msgstr "نقش پیش‌فرض کاربران جدید"

#: admin/class-sml-admin-page.php:161
msgid "Redirect after login"
msgstr "انتقال پس از ورود"

#: admin/class-sml-admin-page.php:162
msgid "Where users land after logging in, verifying their email, or resetting their password — unless a specific destination was already requested (e.g. Cart/Checkout). Leave unset to use the site home page. Tip: point this at your My Account page."
msgstr "کاربران پس از ورود، تأیید ایمیل یا بازیابی رمز عبور به این صفحه منتقل می‌شوند، مگر این‌که مقصد مشخصی از قبل درخواست شده باشد (مثلاً سبد خرید/تسویه‌حساب). برای استفاده از صفحهٔ اصلی سایت، خالی بگذارید. نکته: آن را روی صفحهٔ «حساب کاربری من» تنظیم کنید."

#: admin/class-sml-admin-page.php:1631
msgid "Preview"
msgstr "پیش‌نمایش"

#: admin/class-sml-admin-page.php:1633
msgid "Preview email"
msgstr "پیش‌نمایش ایمیل"

#: admin/class-sml-admin-page.php:1634
msgid "Shows this email exactly as a customer receives it — header, card, button and footer — using sample data. Unsaved edits above are included."
msgstr "این ایمیل را دقیقاً همان‌طور که مشتری دریافت می‌کند (سربرگ، کارت، دکمه و پاورقی) با داده‌های نمونه نشان می‌دهد. تغییرات ذخیره‌نشدهٔ بالا هم لحاظ می‌شوند."

#: admin/class-sml-admin-page.php:1648 admin/class-sml-admin-page.php:1651
msgid "Email preview"
msgstr "پیش‌نمایش ایمیل"

#: admin/class-sml-admin-page.php:167
msgid "Button appearance"
msgstr "ظاهر دکمه"

#: admin/class-sml-admin-page.php:168
msgid "Colors for the primary button (Log In, Create Account, Verify). Secondary buttons and links are unaffected."
msgstr "رنگ‌های دکمهٔ اصلی (ورود، ایجاد حساب، تأیید). دکمه‌های ثانویه و لینک‌ها تغییر نمی‌کنند."

#: admin/class-sml-admin-page.php:170
msgid "Button background color"
msgstr "رنگ پس‌زمینهٔ دکمه"

#: admin/class-sml-admin-page.php:171
msgid "Button text color"
msgstr "رنگ متن دکمه"

#: admin/class-sml-admin-page.php:1710
msgid "Test SMS"
msgstr "پیامک آزمایشی"

#: admin/class-sml-admin-page.php:1712
msgid "Send test SMS"
msgstr "ارسال پیامک آزمایشی"

#: admin/class-sml-admin-page.php:1714
msgid "Sends a sample code to this number using the saved gateway settings (save your changes first). Use an Iranian number such as 09123456789, or +<country code><number>."
msgstr "یک کد نمونه را با تنظیمات ذخیره‌شدهٔ درگاه به این شماره می‌فرستد (ابتدا تغییرات را ذخیره کنید). از شمارهٔ ایرانی مثل 09123456789 یا فرمت +<کد کشور><شماره> استفاده کنید."

#: admin/class-sml-admin-page.php:1723 admin/class-sml-admin-page.php:1817 includes/class-sml-shortcode.php:80
msgid "Sending…"
msgstr "در حال ارسال…"

#: admin/class-sml-admin-page.php:1734 admin/class-sml-admin-page.php:1826 admin/class-sml-admin-page.php:1958
msgid "Request failed."
msgstr "درخواست ناموفق بود."

#: admin/class-sml-admin-page.php:175
msgid "Shortcode & form page"
msgstr "شورت‌کد و صفحهٔ فرم"

#: admin/class-sml-admin-page.php:1766 includes/class-sml-phone.php:148
msgid "Please enter a valid mobile number."
msgstr "لطفاً یک شمارهٔ موبایل معتبر وارد کنید."

#: admin/class-sml-admin-page.php:1775
msgid "Fill in the gateway settings and save them first."
msgstr "ابتدا تنظیمات درگاه را پر و ذخیره کنید."

#: admin/class-sml-admin-page.php:179
msgid "Shortcode"
msgstr "شورت‌کد"

#. translators: %s: error detail from the SMS gateway
#: admin/class-sml-admin-page.php:1790
#, php-format
msgid "The gateway refused the message: %s"
msgstr "درگاه پیام را رد کرد: %s"

#. translators: %s: masked phone number
#: admin/class-sml-admin-page.php:1799
#, php-format
msgid "Sample code sent to %s."
msgstr "کد نمونه به %s ارسال شد."

#: admin/class-sml-admin-page.php:1806
msgid "Test delivery"
msgstr "آزمایش ارسال"

#: admin/class-sml-admin-page.php:1807
msgid "Send test email"
msgstr "ارسال ایمیل آزمایشی"

#: admin/class-sml-admin-page.php:1809
msgid "Sends a plain test email to your account using the exact same code path as every other Smart Login email. If this fails too, the problem is your SMTP setup (e.g. WP Mail SMTP), not this plugin."
msgstr "یک ایمیل آزمایشی ساده را با همان مسیر سایر ایمیل‌های Smart Login به حساب شما می‌فرستد. اگر این ارسال هم ناموفق بود، مشکل از تنظیمات SMTP شماست (مثلاً WP Mail SMTP) و نه این افزونه."

#: admin/class-sml-admin-page.php:181 admin/class-sml-admin-page.php:312
msgid "Copied!"
msgstr "کپی شد!"

#: admin/class-sml-admin-page.php:181 admin/class-sml-admin-page.php:312
msgid "Copy"
msgstr "کپی"

#: admin/class-sml-admin-page.php:1855
msgid "Smart Login test email"
msgstr "ایمیل آزمایشی Smart Login"

#: admin/class-sml-admin-page.php:1856
msgid "If you are reading this, Smart Login was able to send email through this site's configured mailer."
msgstr "اگر این پیام را می‌خوانید، Smart Login توانسته از طریق سیستم ایمیل تنظیم‌شدهٔ این سایت ایمیل ارسال کند."

#: admin/class-sml-admin-page.php:186
msgid "Login page"
msgstr "صفحهٔ ورود"

#: admin/class-sml-admin-page.php:187
msgid "The page that contains the [smart_login_form] shortcode. Password-reset and email-verification links point here so they open the form. Also used as the redirect target for login-gated Cart/Checkout. If left unset, the plugin tries to find the page automatically."
msgstr "صفحه‌ای که شورت‌کد [smart_login_form] در آن قرار دارد. لینک‌های بازیابی رمز عبور و تأیید ایمیل به این صفحه اشاره می‌کنند تا فرم باز شود. همچنین مقصد انتقال برای سبد خرید/تسویه‌حسابِ نیازمند ورود است. اگر تنظیم نشود، افزونه سعی می‌کند صفحه را خودکار پیدا کند."

#: admin/class-sml-admin-page.php:1870
msgid "wp_mail() returned false with no further detail from your mailer."
msgstr "تابع wp_mail() مقدار false برگرداند و سیستم ایمیل شما جزئیات بیشتری ارائه نکرد."

#. translators: %s: email address
#: admin/class-sml-admin-page.php:1879
#, php-format
msgid "Sent to %s — check your inbox (and spam folder)."
msgstr "به %s ارسال شد؛ صندوق ورودی (و پوشهٔ اسپم) را بررسی کنید."

#: admin/class-sml-admin-page.php:1894
msgid "Export"
msgstr "برون‌بری"

#: admin/class-sml-admin-page.php:1895
msgid "Download settings JSON"
msgstr "دانلود تنظیمات (JSON)"

#: admin/class-sml-admin-page.php:1897
msgid "Downloads every setting as a JSON file. Bot-protection secret keys are left out, so the file is safe to send for review."
msgstr "همهٔ تنظیمات را به‌صورت فایل JSON دانلود می‌کند. کلیدهای محرمانهٔ محافظت در برابر ربات‌ها در آن نیست، بنابراین ارسال فایل برای بررسی امن است."

#: admin/class-sml-admin-page.php:1900 admin/class-sml-admin-page.php:1904
msgid "Import"
msgstr "درون‌ریزی"

#: admin/class-sml-admin-page.php:1901
msgid "Paste an exported JSON below (or choose a file), then Import. Unknown keys are ignored; secret keys already stored are kept."
msgstr "یک JSON برون‌بری‌شده را در کادر زیر جای‌گذاری کنید (یا فایل انتخاب کنید) و روی «درون‌ریزی» بزنید. کلیدهای ناشناخته نادیده گرفته می‌شوند و کلیدهای محرمانهٔ ذخیره‌شده حفظ می‌شوند."

#: admin/class-sml-admin-page.php:192
msgid "Allowed countries for registration"
msgstr "کشورهای مجاز برای ثبت‌نام"

#: admin/class-sml-admin-page.php:1926
msgid "Downloaded."
msgstr "دانلود شد."

#: admin/class-sml-admin-page.php:1928
msgid "Export failed."
msgstr "برون‌بری ناموفق بود."

#: admin/class-sml-admin-page.php:193
msgid "Only checked countries appear in the mobile-number country selector on the registration form; registering with any other country is rejected server-side too. Enabled by default: United States, Canada, and Western Europe."
msgstr "فقط کشورهای انتخاب‌شده در فهرست کشور شمارهٔ موبایل فرم ثبت‌نام نمایش داده می‌شوند و ثبت‌نام با هر کشور دیگری در سمت سرور نیز رد می‌شود. به‌طور پیش‌فرض فعال: ایالات متحده، کانادا و اروپای غربی."

#: admin/class-sml-admin-page.php:1947
msgid "Importing…"
msgstr "در حال درون‌ریزی…"

#: admin/class-sml-admin-page.php:195
msgid "Allowed countries"
msgstr "کشورهای مجاز"

#: admin/class-sml-admin-page.php:1954
msgid "Import failed."
msgstr "درون‌ریزی ناموفق بود."

#: admin/class-sml-admin-page.php:199
msgid "Iranian registration"
msgstr "ثبت‌نام ایرانی"

#: admin/class-sml-admin-page.php:200
msgid "Adds Iran to the country list, validates Iranian mobile numbers (10 digits starting with 9, a leading 0 is accepted) and can ask for the national ID when Iran is selected. Persian and Arabic digits are accepted in both fields."
msgstr "ایران را به فهرست کشورها اضافه می‌کند، شماره موبایل ایرانی را اعتبارسنجی می‌کند (۱۰ رقم که با ۹ شروع می‌شود؛ صفر ابتدایی پذیرفته می‌شود) و هنگام انتخاب ایران می‌تواند کد ملی را بخواهد. در هر دو فیلد ارقام فارسی و عربی پذیرفته می‌شود."

#: admin/class-sml-admin-page.php:2014
msgid "That is not valid JSON."
msgstr "این یک JSON معتبر نیست."

#: admin/class-sml-admin-page.php:2022
msgid "This file is an export from a different plugin."
msgstr "این فایل از یک افزونهٔ دیگر برون‌بری شده است."

#: admin/class-sml-admin-page.php:2044
msgid "No recognised settings found in that file."
msgstr "هیچ تنظیم شناخته‌شده‌ای در این فایل پیدا نشد."

#: admin/class-sml-admin-page.php:205
msgid "Iranian mobile numbers & national ID"
msgstr "شماره موبایل ایرانی و کد ملی"

#. translators: %d: number of settings applied
#: admin/class-sml-admin-page.php:2054
#, php-format
msgid "Imported %d settings. Reloading…"
msgstr "%d تنظیم درون‌ریزی شد. در حال بارگذاری مجدد…"

#: admin/class-sml-admin-page.php:211
msgid "Require the national ID"
msgstr "اجباری بودن کد ملی"

#: admin/class-sml-admin-page.php:212
msgid "When off, the field is still shown but may be left empty. Anything entered is always checked and must not already belong to another account."
msgstr "در صورت خاموش بودن، فیلد همچنان نمایش داده می‌شود ولی می‌توان آن را خالی گذاشت. هر مقداری که وارد شود همیشه بررسی می‌شود و نباید متعلق به حساب دیگری باشد."

#: admin/class-sml-admin-page.php:2140
msgid "— Select a page —"
msgstr "— یک صفحه انتخاب کنید —"

#: admin/class-sml-admin-page.php:218
msgid "Disposable email protection"
msgstr "محافظت در برابر ایمیل‌های یکبارمصرف"

#: admin/class-sml-admin-page.php:219
msgid "Rejects registration when the email address's domain matches the list below — reduces fake/fraudulent sign-ups from throwaway inboxes."
msgstr "ثبت‌نام را وقتی دامنهٔ ایمیل در فهرست زیر باشد رد می‌کند؛ ثبت‌نام‌های جعلی یا متقلبانه با صندوق‌های یکبارمصرف را کاهش می‌دهد."

#: admin/class-sml-admin-page.php:2215
msgid "Search countries…"
msgstr "جست‌وجوی کشورها…"

#: admin/class-sml-admin-page.php:2216
msgid "Only checked countries appear in the mobile-number country selector."
msgstr "فقط کشورهای انتخاب‌شده در فهرست کشور شمارهٔ موبایل نمایش داده می‌شوند."

#: admin/class-sml-admin-page.php:2231
msgid "Search roles…"
msgstr "جست‌وجوی نقش‌ها…"

#: admin/class-sml-admin-page.php:2232
msgid "None selected = every role allowed."
msgstr "اگر هیچ‌کدام انتخاب نشود، همهٔ نقش‌ها مجازند."

#: admin/class-sml-admin-page.php:224
msgid "Block disposable/temporary email addresses"
msgstr "مسدود کردن ایمیل‌های یکبارمصرف/موقت"

#: admin/class-sml-admin-page.php:2251
msgid "Saved — leave unchanged, or type a new value to replace it"
msgstr "ذخیره شده است؛ بدون تغییر بگذارید یا برای جایگزینی، مقدار جدید بنویسید"

#: admin/class-sml-admin-page.php:229
msgid "Blocked domains"
msgstr "دامنه‌های مسدود"

#: admin/class-sml-admin-page.php:230
msgid "One domain per line, e.g. mailinator.com — no @ sign."
msgstr "هر دامنه در یک خط، مثلاً mailinator.com، بدون علامت @."

#: admin/class-sml-admin-page.php:2313
msgid "No matches."
msgstr "موردی پیدا نشد."

#: admin/class-sml-admin-page.php:248
msgid "Let visitors sign in or register with their Google account. Independent of the email/password flow — off by default."
msgstr "به بازدیدکنندگان اجازه می‌دهد با حساب گوگل وارد شوند یا ثبت‌نام کنند. مستقل از روش ایمیل/رمز عبور است و به‌طور پیش‌فرض غیرفعال است."

#: admin/class-sml-admin-page.php:251
msgid "Google"
msgstr "گوگل"

#: admin/class-sml-admin-page.php:256
msgid "Enable \"Continue with Google\""
msgstr "فعال‌سازی «ادامه با گوگل»"

#: admin/class-sml-admin-page.php:257
msgid "Adds a Google button above the Log In and Create Account forms. Requires a Client ID and Secret below."
msgstr "یک دکمهٔ گوگل بالای فرم‌های ورود و ایجاد حساب اضافه می‌کند. به شناسهٔ کلاینت و کلید محرمانه (در ادامه) نیاز دارد."

#: admin/class-sml-admin-page.php:262 admin/class-sml-admin-page.php:310
msgid "Redirect URI"
msgstr "نشانی بازگشت (Redirect URI)"

#: admin/class-sml-admin-page.php:263
msgid "Add this exact URL to the OAuth client's \"Authorized redirect URIs\" in the Google Cloud Console — Google will refuse to sign in otherwise."
msgstr "این نشانی را دقیقاً به «Authorized redirect URIs» کلاینت OAuth در Google Cloud Console اضافه کنید؛ در غیر این صورت گوگل ورود را رد می‌کند."

#: admin/class-sml-admin-page.php:269
msgid "Credentials"
msgstr "اطلاعات اعتبارسنجی"

#: admin/class-sml-admin-page.php:270
msgid "From an OAuth 2.0 \"Web application\" client in Google Cloud Console → APIs & Services → Credentials. Upload the downloaded client JSON to fill both fields, or paste them in by hand."
msgstr "از یک کلاینت OAuth 2.0 از نوع «Web application» در Google Cloud Console ← APIs & Services ← Credentials. فایل JSON دانلودشدهٔ کلاینت را بارگذاری کنید تا هر دو فیلد پر شوند، یا آن‌ها را دستی وارد کنید."

#: admin/class-sml-admin-page.php:273
msgid "Client ID"
msgstr "شناسهٔ کلاینت (Client ID)"

#: admin/class-sml-admin-page.php:274
msgid "Client secret"
msgstr "کلید محرمانهٔ کلاینت (Client secret)"

#: admin/class-sml-admin-page.php:274 admin/class-sml-admin-page.php:482
msgid "Stored with autoload disabled and never rendered back in plaintext. Leave blank to keep the current value."
msgstr "با غیرفعال بودن بارگذاری خودکار ذخیره می‌شود و هرگز به‌صورت متن ساده نمایش داده نمی‌شود. برای حفظ مقدار فعلی، خالی بگذارید."

#: admin/class-sml-admin-page.php:278
msgid "Access &amp; account linking"
msgstr "دسترسی و اتصال حساب‌ها"

#: admin/class-sml-admin-page.php:279
msgid "Google sign-in does not go through the normal WordPress login, so plugins that add two-factor authentication there do not run on it. These settings decide how far that shortcut is allowed to reach."
msgstr "ورود با گوگل از مسیر عادی ورود وردپرس عبور نمی‌کند، بنابراین افزونه‌هایی که احراز هویت دومرحله‌ای را در آن مسیر اضافه می‌کنند اجرا نمی‌شوند. این تنظیمات مشخص می‌کنند این میان‌بر تا کجا مجاز باشد."

#: admin/class-sml-admin-page.php:284
msgid "Link Google to existing accounts"
msgstr "اتصال گوگل به حساب‌های موجود"

#: admin/class-sml-admin-page.php:285
msgid "When someone signs in with a Google address that already has an account here, connect the two. Google confirms the address belongs to them first. Turning this off means those visitors must use their password instead. The account owner is emailed the first time a link is made."
msgstr "وقتی کسی با نشانی گوگلی وارد می‌شود که از قبل در این سایت حساب دارد، این دو به هم متصل می‌شوند. گوگل ابتدا تأیید می‌کند که نشانی متعلق به اوست. با خاموش کردن این گزینه، این بازدیدکنندگان باید از رمز عبور استفاده کنند. اولین باری که اتصال برقرار می‌شود، برای صاحب حساب ایمیل ارسال می‌شود."

#: admin/class-sml-admin-page.php:29
msgid "Overview"
msgstr "نمای کلی"

#: admin/class-sml-admin-page.php:290
msgid "Allow Google sign-in for site administrators"
msgstr "اجازهٔ ورود با گوگل برای مدیران سایت"

#: admin/class-sml-admin-page.php:291
msgid "Off by default, and best left off: with it on, anyone who controls an administrator's Google mailbox can sign in as that administrator without the WordPress password and without any second factor."
msgstr "به‌طور پیش‌فرض خاموش است و بهتر است خاموش بماند: با روشن بودن آن، هر کسی که به صندوق ایمیل گوگل یک مدیر دسترسی داشته باشد می‌تواند بدون رمز عبور وردپرس و بدون هیچ عامل دوم، به‌عنوان آن مدیر وارد شود."

#: admin/class-sml-admin-page.php:296
msgid "Keep Google sign-ins signed in"
msgstr "ماندگاری ورود با گوگل"

#: admin/class-sml-admin-page.php:297
msgid "Stay signed in for 14 days after a Google sign-in. Turn off for shared or public computers, so the session ends when the browser closes."
msgstr "پس از ورود با گوگل، ۱۴ روز وارد بمانید. برای رایانه‌های اشتراکی یا عمومی خاموش کنید تا نشست با بستن مرورگر پایان یابد."

