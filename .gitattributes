# Files kept in the repo for development but not shipped in the plugin zip
# (built with: bin\build-release.ps1  ->  release\smart-login-<version>.zip)
/.gitattributes  export-ignore
/.gitignore      export-ignore
/CLAUDE.md       export-ignore
/.claude         export-ignore
/bin             export-ignore
/release         export-ignore

# Normalise line endings so archives are consistent across machines
* text=auto eol=lf
